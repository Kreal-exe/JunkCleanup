<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:JunkCleanup.Localization"
             xmlns:v="clr-namespace:JunkCleanup.Views"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="JunkCleanup.Views.AboutView">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,6,32,28" MaxWidth="820">
            <Border Classes="card" Padding="40,44">
                <StackPanel HorizontalAlignment="Center">
                    <Panel Width="96" Height="96" HorizontalAlignment="Center">
                        <Border CornerRadius="28" Background="{DynamicResource Brush.AccentGradient}" Opacity="0.55" Margin="4,10,4,-2">
                            <Border.Effect>
                                <BlurEffect Radius="28" />
                            </Border.Effect>
                        </Border>
                        <v:Logo Width="96" Height="96" />
                    </Panel>
                    <TextBlock Text="{loc:Str app.name}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,0" />
                    <TextBlock Text="{loc:Str app.tagline}" Classes="muted" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <Border Classes="pill" Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Center" Margin="0,14,0,0" Padding="12,4">
                        <TextBlock Text="{Binding VersionText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                    </Border>
                    <TextBlock Text="{loc:Str about.description}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="580" LineHeight="22" Margin="0,22,0,0" />
                    <WrapPanel HorizontalAlignment="Center" Margin="0,28,0,0">
                        <Button Classes="primary" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/Kreal-exe/JunkCleanup" Margin="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <mi:MaterialIcon Kind="Github" Width="17" Height="17" />
                                <TextBlock Text="{loc:Str about.github}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost" Content="{loc:Str about.issues}" Command="{Binding OpenUrlCommand}"
                                CommandParameter="https://github.com/Kreal-exe/JunkCleanup/issues" Margin="6" Padding="18,12" />
                        <Button Classes="ghost" Content="{loc:Str about.openSettingsFolder}" Command="{Binding OpenFolderCommand}"
                                CommandParameter="{Binding SettingsFolder}" Margin="6" Padding="18,12" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <UniformGrid Columns="3" Margin="-6,10,-6,0" Classes="rise">
                <Border Classes="card" Margin="6" Padding="20,18">
                    <StackPanel>
                        <mi:MaterialIcon Kind="FormatListBulleted" Width="22" Height="22" HorizontalAlignment="Left" Foreground="{DynamicResource Brush.Cat.System}" />
                        <TextBlock Text="{Binding TargetCountText}" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="6" Padding="20,18">
                    <StackPanel>
                        <mi:MaterialIcon Kind="Earth" Width="22" Height="22" HorizontalAlignment="Left" Foreground="{DynamicResource Brush.Cat.Custom}" />
                        <TextBlock Text="{Binding LanguagesText}" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="6" Padding="20,18">
                    <StackPanel>
                        <mi:MaterialIcon Kind="CodeBraces" Width="22" Height="22" HorizontalAlignment="Left" Foreground="{DynamicResource Brush.Cat.Developer}" />
                        <TextBlock Text="{Binding BuiltWithText}" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Classes="card rise" Margin="0,10,0,0" Padding="24,20">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="tile" Width="44" Height="44" CornerRadius="14" Background="{DynamicResource Brush.SuccessSoft}" VerticalAlignment="Top">
                        <mi:MaterialIcon Kind="ShieldCheckOutline" Width="22" Height="22" Foreground="{DynamicResource Brush.Success}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="{loc:Str about.safety}" Classes="h2" />
                        <TextBlock Text="{loc:Str about.safety.desc}" Classes="muted" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="{loc:Str about.license}" Classes="caption" HorizontalAlignment="Center" Margin="0,18,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
