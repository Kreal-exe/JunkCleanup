<Project Sdk="Microsoft.NET.Sdk">

  <!--
    JunkCleanup for Linux: Avalonia UI over the scan and clean engines of the Windows app (linked from
    src/JunkCleanup/Core), with the Linux path resolver, path guard, target catalog and freedesktop Trash in Core/.
    The version is the <Version> of src/JunkCleanup/JunkCleanup.csproj, shared by all three apps.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>JunkCleanup</AssemblyName>
    <RootNamespace>JunkCleanup</RootNamespace>
    <Authors>Kreal-exe</Authors>
    <Product>JunkCleanup</Product>
    <Description>A fast, beautiful cache and junk cleaner for Linux.</Description>
    <Copyright>Copyright © 2026 Kreal-exe</Copyright>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- Linux-only by design: the Unix file-mode APIs are fine here. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- the platform-neutral engine shared with the Windows app -->
  <ItemGroup>
    <Compile Include="..\src\JunkCleanup\Core\ByteFormatter.cs" Link="Core\Shared\ByteFormatter.cs" />
    <Compile Include="..\src\JunkCleanup\Core\CleanupTarget.cs" Link="Core\Shared\CleanupTarget.cs" />
    <Compile Include="..\src\JunkCleanup\Core\ScanEngine.cs" Link="Core\Shared\ScanEngine.cs" />
    <Compile Include="..\src\JunkCleanup\Core\CleanEngine.cs" Link="Core\Shared\CleanEngine.cs" />
    <Compile Include="..\src\JunkCleanup\Core\DiskMap.cs" Link="Core\Shared\DiskMap.cs" />
    <Compile Include="..\src\JunkCleanup\Core\ProjectArtifacts.cs" Link="Core\Shared\ProjectArtifacts.cs" />
  </ItemGroup>

  <!-- the Windows app's translations, then the Linux wording laid over them -->
  <ItemGroup>
    <EmbeddedResource Include="..\src\JunkCleanup\Localization\Strings\*.json" Link="Strings\%(Filename)%(Extension)" LogicalName="Strings.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\Strings\*.json" LogicalName="Strings-linux.%(Filename)%(Extension)" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Material.Icons.Avalonia" Version="2.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JunkCleanup.Linux.Tests" />
  </ItemGroup>

  <!-- One version for all apps: read it from the Windows project before the assembly info is generated. -->
  <Target Name="ShareVersion" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;GetPackageVersion">
    <XmlPeek XmlInputPath="..\src\JunkCleanup\JunkCleanup.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="SharedVersion" />
    </XmlPeek>
    <PropertyGroup>
      <Version>$(SharedVersion)</Version>
      <AssemblyVersion>$(SharedVersion).0</AssemblyVersion>
      <FileVersion>$(SharedVersion).0</FileVersion>
      <InformationalVersion>$(SharedVersion)</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>
