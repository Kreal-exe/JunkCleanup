<UserControl x:Class="JunkCleanup.Views.DiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:JunkCleanup.Controls"
             xmlns:loc="clr-namespace:JunkCleanup.Localization"
             xmlns:vm="clr-namespace:JunkCleanup.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:DiskViewModel}">

    <UserControl.Resources>
        <!-- one row: a known item, a part of one, or a discovered folder -->
        <DataTemplate x:Key="SpaceRow" DataType="{x:Type vm:SpaceItemVm}">
            <Border CornerRadius="14" Padding="14,12" Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.Inset}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource IconTile}" Width="38" Height="38" CornerRadius="11" Background="{Binding SoftBrush}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="16" Foreground="{Binding Brush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                        <WrapPanel>
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Background="{Binding RiskSoftBrush}" ToolTip="{Binding RiskHint}">
                                <TextBlock Text="{Binding RiskText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding RiskBrush}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding PathText}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                   ToolTip="{Binding PathText}" Visibility="{Binding HasPath, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Visibility="{Binding HasSafe, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource Brush.Success}" />
                            <TextBlock Text="{Binding SafeText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="110" Margin="0,0,12,0">
                        <TextBlock c:Counter.Bytes="{Binding Bytes}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <c:SmoothBar Value="{Binding Share}" Fill="{Binding Brush}" Track="{DynamicResource Brush.Track}" Height="5" Margin="0,7,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Padding="10,6" FontSize="12" Margin="0,0,4,0"
                                Visibility="{Binding IsCleanable, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.CleanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE75C;" Style="{StaticResource Glyph}" FontSize="12" />
                                <TextBlock Text="{loc:Str disk.clean}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="10,6" FontSize="12" Margin="0,0,4,0" ToolTip="{Binding Entry.Command}"
                                Visibility="{Binding IsRepairable, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.RepairCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE90F;" Style="{StaticResource Glyph}" FontSize="12" />
                                <TextBlock Text="{loc:Str disk.repair}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="10,6" FontSize="12" Margin="0,0,4,0" ToolTip="{Binding Entry.Command}"
                                Visibility="{Binding HasCommand, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.CopyCommandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="12" />
                                <TextBlock Text="{loc:Str insight.copyCommand}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="{loc:Str details.reveal}"
                                Visibility="{Binding CanReveal, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        <Grid Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="{loc:Str details.delete}"
                                    Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisInverse}}"
                                    Command="{Binding DataContext.AskDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <Button Style="{StaticResource DangerButton}" Padding="12,6" FontSize="12.5"
                                    Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource Brush.TextOnAccent}" />
                                    <TextBlock Text="{loc:Str details.confirm}" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Button Content="&#xE70D;" Margin="4,0,0,0" RenderTransformOrigin="0.5,0.5"
                                Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <Button.RenderTransform>
                                <RotateTransform />
                            </Button.RenderTransform>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.3">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- its parts -->
                    <c:Collapsible Grid.Row="1" Grid.ColumnSpan="4" IsOpen="{Binding IsExpanded}">
                        <ItemsControl Margin="52,12,0,-8" ItemsSource="{Binding Children}" ItemTemplate="{DynamicResource SpaceRow}" />
                    </c:Collapsible>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,6,32,28" MaxWidth="1320">

            <!-- header -->
            <Grid c:Entrance.Delay="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{loc:Str disk.title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding SubtitleText}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- which drive to map, when there is more than one -->
                    <ComboBox Style="{StaticResource Combo}" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" MinWidth="230" Height="44"
                              Margin="0,0,12,0" ToolTip="{loc:Str disk.drive}" Visibility="{Binding HasDrives, Converter={StaticResource BoolToVis}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DriveOption}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEDA2;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FreeText}" Style="{StaticResource Muted}" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AnalyzeCommand}" MinWidth="190">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding AnalyzeGlyph}" Style="{StaticResource Glyph}" FontSize="15" Foreground="{DynamicResource Brush.TextOnAccent}" />
                            <TextBlock Text="{Binding AnalyzeText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- the whole disk, band by band -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="28,26" c:Entrance.Delay="60">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{loc:Str disk.map}" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding FreeText}" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <c:SegmentBar ItemsSource="{Binding Segments}" BrushPath="DisplayBrush" Command="{Binding PickSegmentCommand}" Total="{Binding Total}"
                                  Track="{DynamicResource Brush.Track}" Height="26" Gap="3" Margin="0,18,0,18" ToolTip="{loc:Str disk.pickBand}" />
                    <ItemsControl ItemsSource="{Binding Segments}" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SegmentVm}">
                                <!-- a legend entry picks its band, like the bar does -->
                                <Button Margin="0,0,10,6" Padding="8,4" Cursor="Hand" Focusable="False" Visibility="{Binding HasBytes, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.PickSegmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="9" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsPicked}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Width="10" Height="10" CornerRadius="3" Background="{Binding Brush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock c:Counter.Bytes="{Binding Bytes}" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <!-- everything Safe, in one go -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding CanRemoveSafe, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SafeText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Success}" Margin="6,0,14,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource SuccessButton}" Padding="16,10" FontSize="13" Command="{Binding RemoveSafeCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Brush.TextOnAccent}" />
                                    <TextBlock Text="{loc:Str disk.removeSafe}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- what takes the space -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="24,22"
                    Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}" c:Entrance.Replay="{Binding HasReport}">
                <StackPanel>
                    <TextBlock Text="{loc:Str disk.whatsTaking}" Style="{StaticResource H2}" />
                    <TextBlock Text="{loc:Str disk.whatsTaking.desc}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,16" />
                    <!-- the band picked in the bar, with a way back to everything -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Visibility="{Binding IsFiltered, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding FilterText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12" Margin="12,0,0,0" Command="{Binding ClearFilterCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="11" />
                                <TextBlock Text="{loc:Str disk.filter.all}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{loc:Str disk.filter.empty}" Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12"
                               Visibility="{Binding IsFilterEmpty, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding ItemsView}" ItemTemplate="{StaticResource SpaceRow}" c:Entrance.Stagger="30" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
